# LiteLLM proxy (OpenAI-compatible) configuration.
# Copy this file to .env and fill in real values. Never commit .env.

# Required for LLM/embedding calls (graders inject their own values)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional overrides (safe defaults; uncomment to change)
#LLM_PROVIDER=openai
#CORPUS_DIR=/app/corpus
#CACHE_DIR=/tmp/synapse-cache
#MAX_SUB_GOALS=5
#MAX_TOOL_CALLS=4
#REQUEST_TIMEOUT_S=90
#LOG_LEVEL=INFO
